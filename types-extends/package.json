  "version": "0.3.0",
  "description": "Type definitions to extend modules",
  "author": "Autistic_Intelligence",
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "scripts": {},
  "main": "./dist/index.js",
  "type": "module",
  "keywords": [
    "node",
    "utilities",
    "typescript",
    "types-extends"
  ]
}
