# ==============================================================================
# Node Yalc - Monorepo .gitignore
# Tailored for TypeScript / ESM / Yalc Multi-Package Workspace
# ==============================================================================

# Dependencies
node_modules/
**/node_modules/
jspm_packages/

# TypeScript & Build Outputs (Root and all subpackages)
dist/
**/dist/
build/
**/build/
out/
**/out/
.next/
.turbo/
.cache/
.parcel-cache/
*.tsbuildinfo
**/*.tsbuildinfo
*.tgz
**/*.tgz

# In-source compiled maps (generated during testing/tsc)
*.js.map
**/*.js.map

# Testing, Coverage & Documentation
coverage/
**/coverage/
.nyc_output/
*.lcov
docs/compodoc/
jestcoverage/
**/jestcoverage/

# Yalc & Local Package Linking
.yalc/
**/.yalc/
yalc.lock
**/yalc.lock
.yalc-*

# Syncwheel Metadata (when linking with nestjs-yalc)
.syncwheel/
**/.syncwheel/

# Scratch & Temporary Testing Scripts
scratch/
**/scratch/
scratch_*
scratch.*
build-errors.log

# Environment Variables & Secrets
.env
.env.local
.env.*.local
.env*.local
*.env
!.env.example
*.pem
*.key

# Logs
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDEs and Code Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
